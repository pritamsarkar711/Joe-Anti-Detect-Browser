<?xml version="1.0" encoding="utf-8"?>
<!-- Painted while the WebView starts, so the app never flashes a bare frame.
     The logo is drawn at its intrinsic 88dp, centred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F6F7F9" />
        </shape>
    </item>
    <item android:gravity="center" android:drawable="@drawable/ic_mark" />
</layer-list>
