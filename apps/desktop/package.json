{
  "name": "joe-browser-desktop",
  "version": "3.2.2",
  "private": true,
  "main": "main.js",
  "description": "Joe Browser \u2014 Electron desktop shell (Windows EXE)",
  "author": "Joe Browser",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.joebrowser.desktop",
    "productName": "Joe Browser",
    "copyright": "Copyright \u00a9 2026 Joe Browser",
    "directories": {
      "output": "release",
      "buildResources": "../../build"
    },
    "files": [
      "main.js",
      "preload.js",
      "rest.js",
      "extensions.cjs",
      "core.cjs",
      "chrome.html",
      "web-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../../build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "JoeBrowser-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "JoeBrowser-Portable-${version}.${ext}"
    },
    "icon": "../../build/icon.ico"
  }
}
