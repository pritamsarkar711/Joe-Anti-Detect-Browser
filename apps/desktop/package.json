{
  "name": "joe-browser-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "description": "Joe Browser — Electron desktop shell (Windows EXE)",
  "author": "Joe Browser",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.joebrowser.desktop",
    "productName": "Joe Browser",
    "copyright": "Copyright © 2026 Joe Browser",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "rest.js", "core.cjs", "web-dist/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "JoeBrowser-Setup-${version}.${ext}" },
    "portable": { "artifactName": "JoeBrowser-Portable-${version}.${ext}" }
  }
}
