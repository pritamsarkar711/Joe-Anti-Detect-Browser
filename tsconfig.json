{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@joe/core": ["packages/core/src/index.ts"],
      "@joe/fingerprint": ["packages/fingerprint/src/index.ts"],
      "@joe/sync": ["packages/sync/src/index.ts"],
      "@/*": ["src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "packages", "vite.config.ts", "scripts"]
}
